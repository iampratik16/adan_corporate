# Adan Corporate. Copy to .env.local. Nothing here is required to run the site.

# --- Contact form -----------------------------------------------------------
# Without a key the form still works end to end: the payload is logged to the
# server console and the success state renders, so the flow is testable with no
# secrets. Get a key at https://resend.com
RESEND_API_KEY=

# Where enquiries are delivered. Leave this empty in production: each enquiry
# route in content/site.ts carries its own mailbox (partners@, careers@, info@)
# and the form sends to that one. Set it on staging to divert every enquiry to a
# single inbox so test submissions never reach the firm.
CONTACT_TO_EMAIL=

# --- Media generation -------------------------------------------------------
# Only needed to regenerate photography and film. Authentication is via
# Application Default Credentials, never an API key:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=

# --- Analytics --------------------------------------------------------------
# None by default, and no cookie banner, because no cookies are set. If Plausible
# is added later, set the domain here and the hook in src/app/layout.tsx picks it up.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
